build eraser_static: CXX_EXECUTABLE_LINKER__eraser_static_Debug CMakeFiles/eraser_static.dir/eraser_static/src/main.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/parser.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/graph_visualizer.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/call_graph.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/lockset.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/file_includes.cpp.o CMakeFiles/eraser_static.dir/eraser_static/src/construction_environment.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/basic_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/break_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/continue_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/continue_return_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/endif_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/endwhile_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/eraser_ignore_on_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/eraser_ignore_off_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/function_call_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/graph_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/if_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/lock_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/read_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/return_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/start_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/startwhile_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/thread_create_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/thread_join_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/unlock_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/while_node.cpp.o CMakeFiles/eraser_static.dir/eraser_static/graph_nodes/src/write_node.cpp.o | /usr/lib/llvm-18/lib/libclang.so
  FLAGS = -g
  LINK_LIBRARIES = -Wl,-rpath,/lib:/usr/lib/llvm-18/lib  /usr/lib/llvm-18/lib/libclang.so
  OBJECT_DIR = CMakeFiles/eraser_static.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = eraser_static
  TARGET_PDB = eraser_static.dbg


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/jude/EraserStatic/build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/jude/EraserStatic/build && /usr/bin/cmake --regenerate-during-build -S/home/jude/EraserStatic -B/home/jude/EraserStatic/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

